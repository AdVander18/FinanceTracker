<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:FinanceTracker.Views"
        mc:Ignorable="d" d:DesignWidth="920" d:DesignHeight="700"
        x:Class="FinanceTracker.Views.StatsWindow"
        Icon="avares://FinanceTracker/Assets/app.ico"
        Width="920" Height="700"
        MinWidth="480" MinHeight="520"
        WindowStartupLocation="CenterOwner">
	<views:StatsView x:Name="StatsContent"/>
</Window>
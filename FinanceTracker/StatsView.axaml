<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:FinanceTracker.Models"
        xmlns:loc="using:FinanceTracker.Localization"
        mc:Ignorable="d" d:DesignWidth="920" d:DesignHeight="700"
        x:Class="FinanceTracker.Views.StatsView"
        Background="{DynamicResource WindowBackgroundBrush}">

	<UserControl.Styles>
		<Style Selector="TextBlock.statsTitle">
			<Setter Property="FontSize" Value="22"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="{DynamicResource TitleForegroundBrush}"/>
		</Style>
		<Style Selector="TextBlock.statsLabel">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Foreground" Value="{DynamicResource SubtitleForegroundBrush}"/>
		</Style>
		<Style Selector="TextBlock.statsValue">
			<Setter Property="FontSize" Value="19"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Foreground" Value="{DynamicResource TitleForegroundBrush}"/>
		</Style>
		<Style Selector="Border.statCard">
			<Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="BoxShadow" Value="0 2 5 0 #22000000"/>
			<Setter Property="Margin" Value="4"/>
			<Setter Property="Padding" Value="12"/>
		</Style>
		<Style Selector="TextBlock.topRank">
			<Setter Property="FontSize" Value="18"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Width" Value="28"/>
			<Setter Property="TextAlignment" Value="Center"/>
			<Setter Property="Margin" Value="0,0,10,0"/>
		</Style>
		<Style Selector="TextBlock.topName">
			<Setter Property="FontSize" Value="15"/>
			<Setter Property="FontWeight" Value="Medium"/>
			<Setter Property="Foreground" Value="{DynamicResource ItemNameForegroundBrush}"/>
		</Style>
		<Style Selector="TextBlock.topAmount">
			<Setter Property="FontSize" Value="16"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Foreground" Value="{DynamicResource ItemAmountForegroundBrush}"/>
		</Style>
		<Style Selector="TextBlock.legendName">
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Foreground" Value="{DynamicResource ItemNameForegroundBrush}"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style Selector="TextBlock.legendAmount">
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="{DynamicResource ItemAmountForegroundBrush}"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="TextAlignment" Value="Right"/>
			<Setter Property="MinWidth" Value="90"/>
		</Style>
		<Style Selector="TextBlock.legendPercent">
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Foreground" Value="{DynamicResource SubtitleForegroundBrush}"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="TextAlignment" Value="Right"/>
			<Setter Property="MinWidth" Value="56"/>
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="Auto,Auto,*" Margin="16">
		<!-- Заголовок -->
		<Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,10">
			<Button Grid.Column="0" x:Name="BackButton"
					Background="Transparent" BorderThickness="0"
					Foreground="{DynamicResource TitleForegroundBrush}"
					Padding="6" VerticalAlignment="Center"
					ToolTip.Tip="{loc:Loc Stats_Back}"
					Click="OnBackClick">
				<Path Data="{StaticResource IconBack}"
					  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
					  Width="24" Height="24" Stretch="Uniform"/>
			</Button>
			<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
				<Path Data="{StaticResource IconStats}"
					  Fill="{DynamicResource TitleForegroundBrush}"
					  Width="26" Height="26" Stretch="Uniform"/>
				<TextBlock Text="{loc:Loc Stats_Title}" Classes="statsTitle" Margin="0"/>
			</StackPanel>
		</Grid>

		<!-- Выбор периода -->
		<Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,10">
			<TextBlock Text="{loc:Loc Stats_PeriodLabel}" Classes="statsLabel" FontSize="14" VerticalAlignment="Center"/>
			<ComboBox Grid.Column="1" x:Name="MonthComboBox" MinWidth="130" SelectionChanged="OnPeriodChanged"/>
			<ComboBox Grid.Column="2" x:Name="YearComboBox" MinWidth="90" SelectionChanged="OnPeriodChanged"/>
		</Grid>

		<!-- Вкладки -->
		<TabControl Grid.Row="2">
			<TabItem Header="{loc:Loc Stats_Tab_Categories}">
				<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
					<StackPanel Spacing="10" Margin="4">
						<Border Classes="statCard">
							<Grid>
								<TextBlock x:Name="CategoriesEmpty"
										   Text="{loc:Loc Stats_NoData}"
										   Classes="statsLabel" FontSize="14"
										   HorizontalAlignment="Center" VerticalAlignment="Center"
										   TextWrapping="Wrap" Margin="0,24"
										   IsVisible="False"/>
								<Viewbox x:Name="PieHost"
										 MaxWidth="420" MaxHeight="420"
										 HorizontalAlignment="Center"
										 IsVisible="False">
									<Canvas x:Name="PieCanvas" Width="260" Height="260"/>
								</Viewbox>
							</Grid>
						</Border>
						<Border Classes="statCard" Padding="14">
							<StackPanel Spacing="6">
								<Grid ColumnDefinitions="Auto,*,Auto,Auto">
									<TextBlock Text="{loc:Loc Stats_Category}" Classes="statsLabel" VerticalAlignment="Center"/>
									<TextBlock Grid.Column="2" Text="{loc:Loc Stats_Amount}" Classes="legendAmount"/>
									<TextBlock Grid.Column="3" Text="{loc:Loc Stats_Share}" Classes="legendPercent"/>
								</Grid>
								<ItemsControl x:Name="LegendItems">
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="models:StatsCategoryItem">
											<Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,5">
												<Ellipse Width="14" Height="14" Fill="{Binding Brush}"
														 Stroke="{DynamicResource CardBackgroundBrush}" StrokeThickness="1"
														 VerticalAlignment="Center"/>
												<TextBlock Grid.Column="1" Text="{Binding Category}" Classes="legendName" Margin="10,0,8,0"/>
												<TextBlock Grid.Column="2" Text="{Binding AmountText}" Classes="legendAmount"/>
												<TextBlock Grid.Column="3" Text="{Binding PercentText}" Classes="legendPercent"/>
											</Grid>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</Border>
					</StackPanel>
				</ScrollViewer>
			</TabItem>

			<TabItem Header="{loc:Loc Stats_Tab_Year}">
				<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
					<StackPanel Spacing="10" Margin="4">
						<WrapPanel HorizontalAlignment="Stretch" ItemWidth="190">
							<Border Classes="statCard" MinWidth="150" MaxWidth="330">
								<StackPanel Spacing="2">
									<TextBlock Text="{loc:Loc Stats_YearTotal}" Classes="statsLabel"/>
									<TextBlock x:Name="YearTotalValue" Classes="statsValue"/>
								</StackPanel>
							</Border>
							<Border Classes="statCard" MinWidth="150" MaxWidth="330">
								<StackPanel Spacing="2">
									<TextBlock Text="{loc:Loc Stats_AvgMonth}" Classes="statsLabel"/>
									<TextBlock x:Name="YearAvgValue" Classes="statsValue"/>
								</StackPanel>
							</Border>
							<Border Classes="statCard" MinWidth="150" MaxWidth="330">
								<StackPanel Spacing="2">
									<TextBlock Text="{loc:Loc Stats_Records}" Classes="statsLabel"/>
									<TextBlock x:Name="YearRecordsValue" Classes="statsValue"/>
								</StackPanel>
							</Border>
							<Border Classes="statCard" MinWidth="150" MaxWidth="330">
								<StackPanel Spacing="2">
									<TextBlock Text="{loc:Loc Stats_MaxMonth}" Classes="statsLabel"/>
									<TextBlock x:Name="YearMaxValue" Classes="statsValue"/>
									<TextBlock x:Name="YearMaxLabel" Classes="statsLabel"/>
								</StackPanel>
							</Border>
							<Border Classes="statCard" MinWidth="150" MaxWidth="330">
								<StackPanel Spacing="2">
									<TextBlock Text="{loc:Loc Stats_MinMonth}" Classes="statsLabel"/>
									<TextBlock x:Name="YearMinValue" Classes="statsValue"/>
									<TextBlock x:Name="YearMinLabel" Classes="statsLabel"/>
								</StackPanel>
							</Border>
						</WrapPanel>

						<TextBlock x:Name="YearEmpty"
								   Text="{loc:Loc Stats_YearEmpty}"
								   Classes="statsLabel" FontSize="14"
								   HorizontalAlignment="Center" Margin="0,20"
								   TextWrapping="Wrap"
								   IsVisible="False"/>

						<Border Classes="statCard" Padding="14">
							<StackPanel Spacing="4">
								<TextBlock Text="{loc:Loc Stats_ByMonth}" Classes="statsLabel" FontSize="14" Margin="0,0,0,8"/>
								<StackPanel x:Name="YearRowsPanel" Orientation="Vertical" Spacing="8"/>
							</StackPanel>
						</Border>
					</StackPanel>
				</ScrollViewer>
			</TabItem>

			<TabItem Header="{loc:Loc Stats_Tab_Top}">
				<Grid RowDefinitions="Auto,*" Margin="4">
					<TextBlock Grid.Row="0" Text="{loc:Loc Stats_TopHint}" Classes="statsLabel" FontSize="13" Margin="8,2"/>
					<Border Grid.Row="1" Classes="statCard" Margin="4,4,4,8">
						<Grid>
							<TextBlock x:Name="TopEmpty"
									   Text="{loc:Loc Stats_TopEmpty}"
									   Classes="statsLabel" FontSize="14"
									   HorizontalAlignment="Center" VerticalAlignment="Center"
									   TextWrapping="Wrap" Margin="0,20"
									   IsVisible="False"/>
							<ScrollViewer x:Name="TopScroll"
										  VerticalScrollBarVisibility="Auto"
										  HorizontalScrollBarVisibility="Disabled">
								<ItemsControl x:Name="TopItems">
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="models:StatsTopItem">
											<Grid ColumnDefinitions="Auto,*,Auto" Margin="0,6">
												<TextBlock Grid.Column="0" Text="{Binding Rank}" Classes="topRank" Foreground="{Binding RankBrush}"/>
												<StackPanel Grid.Column="1" Spacing="1">
													<TextBlock Text="{Binding Name}" Classes="topName"/>
													<TextBlock Text="{Binding Category}" Classes="statsLabel" FontSize="11"/>
												</StackPanel>
												<TextBlock Grid.Column="2" Text="{Binding AmountText}" Classes="topAmount" VerticalAlignment="Center" Margin="10,0,0,0"/>
											</Grid>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</ScrollViewer>
						</Grid>
					</Border>
				</Grid>
			</TabItem>
		</TabControl>
	</Grid>
</UserControl>